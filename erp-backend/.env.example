# Copy to .env (kept out of git) or set in the Hostinger panel.
# Backend config
PORT=4000
NODE_ENV=production
# Mandatory in production — use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Local sqlite (default when DB_TYPE is unset)
# DB_PATH=data/erp.db

# Hostinger MariaDB / MySQL
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=erp
DB_PASSWORD=change-me
DB_NAME=erp
# DB_POOL_SIZE=10
